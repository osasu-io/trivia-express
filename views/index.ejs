<!DOCTYPE html>
<html>
<head>
  <title>Trivia Favorites Vault</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .hidden-answer {
      display: none;
    }
  </style>
</head>
<body>
  <h1>🎲 Trivia Favorites Vault</h1>

  <% function decode(str) {
    return str
      .replace(/&quot;/g, '"')
      .replace(/&#039;/g, "'")
      .replace(/&amp;/g, "&")
      .replace(/&eacute;/g, "é")
      .replace(/&ldquo;/g, "“")
      .replace(/&rdquo;/g, "”")
      .replace(/&lsquo;/g, "‘")
      .replace(/&rsquo;/g, "’");
  } %>

  <section class="random">
    <h2>Random Trivia</h2>
    <p><strong>Category:</strong> <%= decode(trivia.category) %></p>
    <p><strong>Question:</strong> <%= decode(trivia.question) %></p>
    <p><strong>Answer:</strong> <span id="answer" class="hidden-answer"><%= decode(trivia.correct_answer) %></span></p>
    <button id="reveal-btn">Show Answer</button>
    <button id="save-btn">Save to Favorites</button>
    <form action="/" method="GET" style="display:inline;">
      <button type="submit">🎲 New Trivia</button>
    </form>
  </section>

  <hr>

  <section class="saved">
    <h2>Saved Trivia</h2>
    <% saved.forEach(item => { %>
      <div class="card">
        <p><strong><%= decode(item.question) %></strong></p>
        <p><em>Answer:</em> <%= decode(item.correct) %></p>
        <p><em>Category:</em> <%= decode(item.category) %></p>
        <% if (item.memorized) { %>
          ✅ Memorized!
        <% } else { %>
          <button class="memorize" data-q="<%= item.question %>">Mark Memorized</button>
        <% } %>
        <button class="delete" data-q="<%= item.question %>">Delete</button>
      </div>
    <% }); %>
  </section>

  <script src="/main.js"></script>
  <script>
    document.getElementById('reveal-btn').addEventListener('click', () => {
      const answerEl = document.getElementById('answer');
      answerEl.classList.toggle('hidden-answer');
    });
  </script>
</body>
</html>
