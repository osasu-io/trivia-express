<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Trivia Vault</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <h1>Trivia Vault</h1>
  <h2>Study questions and save your favorites</h2>

  <h3>Get a Random Question</h3>
  <button id="fetch-btn">Get Trivia Question</button>

  <div id="trivia-card" style="display: none; margin-top: 20px;">
    <p><strong>Question:</strong> <span id="display-question"></span></p>
    <p><strong>Answer:</strong> <span id="display-answer" style="display: none;"></span></p>
    <button id="show-answer-btn">Show Answer</button>

    <form action="/trivia" method="POST" id="save-form">
      <input type="hidden" name="question" id="save-question">
      <input type="hidden" name="answer" id="save-answer">
      <input type="hidden" name="category" id="save-category">
      <input type="hidden" name="difficulty" id="save-difficulty">
      <button type="submit">Save to Favorites</button>
    </form>
  </div>

  <h3>Saved Questions</h3>
  <ul class="trivia-list">
    <% for(var i=0; i<trivia.length; i++) { %>
      <li class="trivia-item">
        <p><strong>Question:</strong> <%= trivia[i].question %></p>
        <p><strong>Answer:</strong> <span class="answer" style="display: none;"><%= trivia[i].answer %></span></p>
        <button class="reveal-answer">Show Answer</button>
        <p><strong>Category:</strong> <%= trivia[i].category %></p>
        <p><strong>Difficulty:</strong> <%= trivia[i].difficulty %></p>
        <p><strong>Memorized:</strong> <%= trivia[i].memorized ? '✅' : '❌' %></p>
        <button class="memorize-btn" data-question="<%= trivia[i].question %>">Mark as Memorized</button>
        <button class="delete-btn" data-question="<%= trivia[i].question %>">Delete</button>
      </li>
    <% } %>
  </ul>

  <script src="/main.js"></script>
</body>
</html>
